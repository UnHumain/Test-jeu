# ---------------------------------------------------------------
#  OLX Car Flipper - configuration
#  Copiez ce fichier en ".env" (main.py le fait automatiquement)
#  puis renseignez vos clés. Ne commitez JAMAIS le fichier .env.
# ---------------------------------------------------------------

# --- Anthropic (obligatoire) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (profondeur de réflexion / coût)
CLAUDE_EFFORT=medium

# --- Telegram (optionnel : laissez vide pour n'avoir que console + logs) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Recherche OLX ---
PRICE_MIN_EUR=500
PRICE_MAX_EUR=1400
# Taux de conversion utilisé pour les annonces affichées en RON
EUR_RON_RATE=5.0
# Slugs OLX : catégorie "Autoturisme" + région "Mures"
OLX_CATEGORY_PATH=auto-masini-moto-ambarcatiuni/autoturisme
OLX_REGION_SLUG=mures
# Optionnel : forcer les IDs numériques si la résolution automatique échoue
OLX_CATEGORY_ID=
OLX_REGION_ID=
# Nombre max de pages (40 annonces/page) lues par cycle
MAX_PAGES=3

# --- Boucle / seuils ---
CHECK_INTERVAL_MINUTES=10
# Plafond d'analyses IA par cycle (maîtrise des coûts au premier lancement)
MAX_ANALYSES_PER_CYCLE=25
# Alerte si note STRICTEMENT supérieure à ce seuil ET marge >= ALERT_MIN_MARGIN_EUR
ALERT_MIN_SCORE=8
ALERT_MIN_MARGIN_EUR=200

# --- Fichiers ---
DB_PATH=data/olx_memory.sqlite3
LOG_DIR=logs
